# Local environment example for Order-Management-Partner-Dashboard
# Copy this to .env.local and fill values, then restart dev server.

# General
NODE_ENV=development
JWT_SECRET=change_this_to_a_secure_value

# Twilio (SMS)
# TWILIO_ACCOUNT_SID must start with 'AC' for Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+919721085784

# Force Twilio client initialization even if `TWILIO_ACCOUNT_SID` doesn't start with 'AC'.
# Use only for local testing when you understand the risks.
# Set to 'true' or '1' to enable.
TWILIO_FORCE=false

# Email (nodemailer)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_or_app_password

# Development helpers (only use locally)
# When SHOW_DEV_OTP=true the server will include OTP in JSON responses (useful for testing)
# To show OTP in the client UI also set NEXT_PUBLIC_SHOW_DEV_OTP=true
SHOW_DEV_OTP=false
NEXT_PUBLIC_SHOW_DEV_OTP=false
# If you want the dev shortcut that creates users without OTP, enable this.
# Use only for quick local testing. When true, registration will auto-verify users.
DEV_SKIP_OTP=false
